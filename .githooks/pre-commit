#!/usr/bin/env bash
# Pre-commit 自检: 业务 widget 里硬编码数字 (padding/fontSize/iconSize/widget 尺寸)
#
# 触发条件: 任何 commit 包含 lib/ 下 .dart 文件
# 失败动作: 列出违规位置 + exit 1 (阻止 commit)
# 跳过方式: git commit --no-verify (紧急情况, commit message 写 why)
#
# 规则来源: AGENTS.md "Code Style Guidelines"
#   No hardcoded size values. All sizes must come from default tokens or
#   ratio-based sizing.
#   → 字号 → textTheme.xxx
#   → 颜色 → colorScheme.xxx
#   → 间距/圆角/容器尺寸 → 走主题、比例式工具或现成 widget
#   → IconButton 大小 → 默认 24 (不写 iconSize)
#
# 合法的硬编码 (允许命中):
#   - EdgeInsets.zero (零内边距)
#   - Duration(milliseconds:/seconds:/...)
#   - CircularProgressIndicator(strokeWidth:)
#   - 比例式写法 (shortestSide * 0.02 这类乘算里的系数)
#
# 安装: bash tool/install_git_hooks.sh

set -e

cd "$(git rev-parse --show-toplevel)"

# 收集 staged 的 lib/ 下 .dart 文件。
#
# app_spacing.dart 是比例式间距的令牌来源(里面的系数是"比例"不是"像素"),
# 按定义允许出现数字,排除掉。
staged=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep '^lib/.*\.dart$' \
  | grep -v '^lib/core/theme/app_spacing\.dart$' \
  || true)

if [ -z "$staged" ]; then
  exit 0
fi

violations=0

echo "🔍 Pre-commit 自检: 业务 widget 硬编码数字..."
echo

check_pattern() {
  local label="$1"
  local pattern="$2"
  local hits
  hits=$(echo "$staged" | xargs grep -nE "$pattern" 2>/dev/null || true)
  if [ -n "$hits" ]; then
    echo "❌ [$label]"
    echo "$hits" | sed 's/^/   /'
    echo
    violations=$((violations + 1))
  fi
}

check_pattern "EdgeInsets.all 数字"   'EdgeInsets\.all\([0-9]'
check_pattern "EdgeInsets.symmetric" 'EdgeInsets\.symmetric\([^)]*[0-9]'
check_pattern "EdgeInsets.fromLTRB"  'EdgeInsets\.fromLTRB\([0-9]'
check_pattern "EdgeInsets.only"      'EdgeInsets\.only\([^)]*[0-9]'
check_pattern "SizedBox 宽高数字"    'SizedBox\(\s*(width|height):\s*[0-9]'
check_pattern "BorderRadius.circular" 'BorderRadius\.circular\([0-9]'
check_pattern "fontSize 数字"        'fontSize:\s*[0-9]'
check_pattern "iconSize 数字"        'iconSize:\s*[0-9]'
check_pattern "width: 数字"          'width:\s*[0-9]+(\.[0-9]+)?[,}]'
check_pattern "height: 数字"         'height:\s*[0-9]+(\.[0-9]+)?[,}]'

if [ $violations -gt 0 ]; then
  echo "❌ Pre-commit 失败: ${violations} 类违规"
  echo
  echo "修法:"
  echo "  1. 用现成 widget (ListTile/Card/Padding 包主题子组件)"
  echo "  2. 尺寸 → 走比例式工具 (lib/core/theme/app_spacing.dart 的写法)"
  echo "  3. 字号 → Theme.of(context).textTheme.xxx"
  echo "  4. 颜色 → Theme.of(context).colorScheme.xxx"
  echo "  5. 紧急绕过: git commit --no-verify (commit message 写 why)"
  echo
  exit 1
fi

echo "✅ Pre-commit 通过: lib/ 下零硬编码数字"
exit 0
